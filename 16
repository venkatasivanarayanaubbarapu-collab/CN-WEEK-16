
# NS2 Experiment: Packet Drop, TCP/UDP, Congestion and Throughput

set ns [new Simulator]

set tf [open ns2_experiment.tr w]
$ns trace-all $tf

set nf [open ns2_experiment.nam w]
$ns namtrace-all $nf

# Create nodes
set n0 [$ns node]
set n1 [$ns node]
set n2 [$ns node]
set n3 [$ns node]
set n4 [$ns node]

# Create network links
$ns duplex-link $n0 $n4 10Mb 10ms DropTail
$ns duplex-link $n1 $n4 10Mb 10ms DropTail
$ns duplex-link $n2 $n4 10Mb 10ms DropTail
$ns duplex-link $n4 $n3 1Mb 10ms DropTail

# Set bottleneck queue size
$ns queue-limit $n4 $n3 10

# TCP traffic from node n0
set tcp0 [new Agent/TCP/Reno]
$ns attach-agent $n0 $tcp0

set sink0 [new Agent/TCPSink]
$ns attach-agent $n3 $sink0
$ns connect $tcp0 $sink0

set ftp0 [new Application/FTP]
$ftp0 attach-agent $tcp0

# UDP traffic from node n1
set udp1 [new Agent/UDP]
$ns attach-agent $n1 $udp1

set null1 [new Agent/Null]
$ns attach-agent $n3 $null1
$ns connect $udp1 $null1

set cbr1 [new Application/Traffic/CBR]
$cbr1 set packetSize_ 1000
$cbr1 set interval_ 0.005
$cbr1 attach-agent $udp1

# Additional TCP traffic from node n2
set tcp2 [new Agent/TCP/Reno]
$ns attach-agent $n2 $tcp2

set sink2 [new Agent/TCPSink]
$ns attach-agent $n3 $sink2
$ns connect $tcp2 $sink2

set ftp2 [new Application/FTP]
$ftp2 attach-agent $tcp2

# Finish procedure
proc finish {} {
    global ns tf nf
    $ns flush-trace
    close $tf
    close $nf
    puts "Simulation completed successfully."
    puts "Trace file: ns2_experiment.tr"
    puts "NAM file: ns2_experiment.nam"
    exit 0
}

# Schedule traffic
$ns at 0.5 "$ftp0 start"
$ns at 0.5 "$cbr1 start"
$ns at 0.5 "$ftp2 start"

$ns at 4.5 "$ftp0 stop"
$ns at 4.5 "$cbr1 stop"
$ns at 4.5 "$ftp2 stop"

$ns at 5.0 "finish"

# Run simulation
$ns run
